# Application
APP_ENV=development
APP_NAME=HacheBaseApp
APP_URL=http://localhost
APP_DEBUG=false
APP_ROOT=/var/www/app
APP_TIMEZONE=UTC
# Example for a Cancun-based deployment: America/Cancun

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=app_database
DB_USER=app_user
DB_PASSWORD=CHANGE_ME

# Internal APIs / automations
INTERNAL_API_TOKEN=CHANGE_ME
N8N_BASE_URL=
N8N_TOKEN=
N8N_CONTAINER=
N8N_DATA_PATH=/home/node/.n8n
N8N_BACKUP_ROOT=/var/backups/n8n

# Deployment / operations
BACKUP_ROOT=/var/backups/app
HEALTHCHECK_URL=https://example.com/health
HEALTHCHECK_TIMEOUT=15
EXPECTED_HEALTH_STATUS=200
MIGRATION_COMMAND=
TEST_COMMAND=bash tests/run.sh
SMOKE_BASE_URL=
HEALTH_PATH=/health

# Transactional mail (recommended: HTTPS API when supported)
MAIL_TRANSPORT=https-api
MAIL_PROVIDER=resend
MAIL_API_KEY=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Example App
MAIL_ALERT_TO=

# Optional SMTP transport/fallback. Verify egress from the real host first.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=

# External payments (optional)
PAYMENT_PROVIDER=
# Legacy/bootstrap fallback only. After persistent configuration takeover,
# resolve credentials through the versioned store instead of direct env reads.
PAYMENT_ACCESS_TOKEN=
PAYMENT_WEBHOOK_SECRET=
# Stable master secret used to encrypt stored payment credential versions.
# Generate a strong random value on the target server and do not rotate it casually.
PAYMENT_GATEWAY_CONFIG_KEY=
PAYMENT_RESERVATION_TTL_MINUTES=30

# IMPORTANT
# Copy this file to .env in the target environment and replace placeholders.
# Never commit .env, SSH keys, production tokens, credentials or database dumps.
