# Dedicated HTTPS reverse proxy for Hache SQL Guard passkey approvals.
# DO NOT enable before DNS, valid Let's Encrypt certificate, isolated service,
# passkey-owner bootstrap and independent backup checks are verified.
server {
    listen 80;
    listen [::]:80;
    server_name aprobaciones.hacheinteractive.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/sqlguard-acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name aprobaciones.hacheinteractive.com;

    ssl_certificate /etc/letsencrypt/live/aprobaciones.hacheinteractive.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aprobaciones.hacheinteractive.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 16k;
    client_body_timeout 15s;
    send_timeout 15s;

    add_header Strict-Transport-Security "max-age=300" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control "no-store" always;

    location / {
        proxy_pass http://127.0.0.1:8173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
        proxy_send_timeout 20s;
        proxy_hide_header Server;
        proxy_buffering off;
    }
}
