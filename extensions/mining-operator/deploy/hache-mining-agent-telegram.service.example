# TEMPLATE ONLY - not an activated service. Configure IDs and systemd credentials securely.
# This service records acknowledgements only. It cannot rent, mutate, or issue grants.
[Unit]
Description=Hache Mining Agent Telegram proposals (no rental authority)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=hache-telegram
Group=hache-telegram
WorkingDirectory=/opt/hache-mining-agent/current
ExecStart=/usr/bin/python3 /opt/hache-mining-agent/current/telegram_proposals.py --database /var/lib/hache-mining-agent/proposals.sqlite --poll --chat-id REPLACE_PRIVATE_CHAT_ID --user-id REPLACE_PRIVATE_USER_ID
LoadCredential=telegram_token:/etc/hache-mining-agent/telegram_token
StateDirectory=hache-mining-agent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=128M
TasksMax=16
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
