[Unit]
Description=Read-only Clore Spot competition quote socket (Telegram requester)
Before=hache-mining-operator-clore-spot-quote.service

[Socket]
ListenStream=/run/hache-clore-spot/quote.sock
SocketUser=root
SocketGroup=hache-telegram
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
