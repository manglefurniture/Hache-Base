[Unit]
Description=Root-isolated audited deployment of approved GitHub releases
Requires=hache-deploy-gate.socket
After=hache-deploy-gate.socket

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/hache-deploy-gate/current
ExecStart=/usr/bin/python3 /opt/hache-deploy-gate/current/deploy_gate.py --config /etc/hache-deploy-gate/config.json
StateDirectory=hache-deploy-gate
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
MemoryHigh=256M
MemoryMax=512M
TasksMax=40
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/hache-miner /opt/hache-mining-operator /var/lib/hache-deploy-gate
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
