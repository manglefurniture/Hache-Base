APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=app_staging
DB_USER=app_staging
DB_PASSWORD=CHANGE_ME

INTERNAL_API_TOKEN=CHANGE_ME_STAGING_ONLY
BACKUP_ROOT=/var/backups/app-staging
HEALTHCHECK_URL=https://staging.example.com/health
SMOKE_BASE_URL=https://staging.example.com

# Never reuse production passwords/tokens in staging.
# Use fictitious or anonymized data only.
